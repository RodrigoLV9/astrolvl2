---
import { WhyChooseCard } from './WhyChooseCard.tsx';
import { getDictionary, getLocaleFromPath } from '../../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---

<section class="whyChooseUs">
    <div class="whyChooseUs__text">
        <h2>{dict.servicesGeneral.whyChoose.title}</h2>
        <p>{dict.servicesGeneral.whyChoose.subtitle}</p>
    </div>
    <div class="whyChooseUs__grid">
        {dict.servicesGeneral.whyChoose.items.map((item) => (
            <WhyChooseCard 
                icon={item.icon}
                title={item.title}
                description={item.description}
            />
        ))}
    </div>
</section>

<style>
    .whyChooseUs {
        padding: 100px 20px;
        margin: 0 auto;
        max-width: 1200px;
    }

    .whyChooseUs__text {
        text-align: center;
        margin-bottom: var(--sp-16);
    }

    .whyChooseUs__text h2 {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 800;
        margin-bottom: var(--sp-5);
        background: linear-gradient(135deg, #e8f3ff 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .whyChooseUs__text p {
        font-size: var(--text-lg);
        color: var(--txt-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .whyChooseUs__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    /* ── Tablet */
    @media (max-width: 1024px) {
        .whyChooseUs {
            padding: 80px 6vw;
        }

        .whyChooseUs__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--sp-6);
        }
    }

    /* ── Mobile */
    @media (max-width: 640px) {
        .whyChooseUs {
            padding: 60px 6vw;
        }

        .whyChooseUs__text {
            margin-bottom: var(--sp-10);
        }

        .whyChooseUs__text h2 {
            font-size: clamp(1.8rem, 5vw, 2rem);
        }

        .whyChooseUs__grid {
            grid-template-columns: 1fr;
            gap: var(--sp-4);
        }
    }

    /* ── Small mobile */
    @media (max-width: 480px) {
        .whyChooseUs {
            padding: var(--sp-12) var(--px);
        }

        .whyChooseUs__text {
            margin-bottom: var(--sp-8);
        }

        .whyChooseUs__text p {
            font-size: var(--text-base);
        }
    }
</style>
