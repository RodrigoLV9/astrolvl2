---
import { WhyChooseCard } from './WhyChooseCard.tsx';
---

<section class="whyChooseUs">
    <div class="whyChooseUs__text">
        <h2>¿Por qué elegirnos?</h2>
        <p>Somos mucho más que una agencia de desarrollo web. Somos tu socio en el crecimiento digital.</p>
    </div>
    <div class="whyChooseUs__grid">
        <WhyChooseCard 
            icon="⚡"
            title="Rápido y Eficiente"
            description="Entregamos proyectos de calidad en tiempos acordados, sin comprometer la excelencia."
        />
        <WhyChooseCard 
            icon="🎨"
            title="Diseño Moderno"
            description="Creamos interfaces atractivas, intuitivas y alineadas con las tendencias actuales."
        />
        <WhyChooseCard 
            icon="📱"
            title="Responsive"
            description="Tus sitios se ven perfectos en cualquier dispositivo: móvil, tablet o escritorio."
        />
        <WhyChooseCard 
            icon="🔍"
            title="SEO Optimizado"
            description="Mejoramos tu visibilidad en buscadores para que tus clientes te encuentren fácilmente."
        />
        <WhyChooseCard 
            icon="🛡️"
            title="Seguro y Confiable"
            description="Implementamos las mejores prácticas de seguridad para proteger tu negocio."
        />
        <WhyChooseCard 
            icon="💬"
            title="Soporte Permanente"
            description="No abandonamos tu proyecto después del lanzamiento. Estamos contigo siempre."
        />
    </div>
</section>

<style>
    .whyChooseUs {
        padding: 100px 20px;
        margin: 0 auto;
        max-width: 1200px;
    }

    .whyChooseUs__text {
        text-align: center;
        margin-bottom: var(--sp-16);
    }

    .whyChooseUs__text h2 {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 800;
        margin-bottom: var(--sp-5);
        background: linear-gradient(135deg, #e8f3ff 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .whyChooseUs__text p {
        font-size: var(--text-lg);
        color: var(--txt-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .whyChooseUs__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    /* ── Tablet */
    @media (max-width: 1024px) {
        .whyChooseUs {
            padding: 80px 6vw;
        }

        .whyChooseUs__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--sp-6);
        }
    }

    /* ── Mobile */
    @media (max-width: 640px) {
        .whyChooseUs {
            padding: 60px 6vw;
        }

        .whyChooseUs__text {
            margin-bottom: var(--sp-10);
        }

        .whyChooseUs__text h2 {
            font-size: clamp(1.8rem, 5vw, 2rem);
        }

        .whyChooseUs__grid {
            grid-template-columns: 1fr;
            gap: var(--sp-4);
        }
    }

    /* ── Small mobile */
    @media (max-width: 480px) {
        .whyChooseUs {
            padding: var(--sp-12) var(--px);
        }

        .whyChooseUs__text {
            margin-bottom: var(--sp-8);
        }

        .whyChooseUs__text p {
            font-size: var(--text-base);
        }
    }
</style>
