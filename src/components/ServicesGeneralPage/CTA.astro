<section class="ctaFinal">
    <div class="ctaFinal__background">
        <div class="ctaFinal__shape shape-1"></div>
        <div class="ctaFinal__shape shape-2"></div>
        <div class="ctaFinal__shape shape-3"></div>
    </div>
    <div class="ctaFinal__content">
        <h2>¿Listo para transformar tu presencia digital?</h2>
        <p>Déjanos ayudarte a encontrar la solución perfecta para tu negocio</p>
        <a href="#contact" class="ctaFinal__button">Comienza tu proyecto hoy</a>
    </div>
</section>

<style>
    .ctaFinal {
        position: relative;
        padding: 100px 20px;
        margin: 100px 0 0 0;
        overflow: hidden;
        background: linear-gradient(180deg, rgba(6, 3, 19, 1) 0%, rgba(20, 10, 40, 0.8) 100%);
    }

    .ctaFinal__background {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    }

    .ctaFinal__shape {
        position: absolute;
        border-radius: 50%;
        opacity: 0.08;
    }

    .shape-1 {
        width: 400px;
        height: 400px;
        background: #60a5fa;
        top: -150px;
        left: -150px;
    }

    .shape-2 {
        width: 300px;
        height: 300px;
        background: #8b5cf6;
        bottom: 50px;
        right: 10%;
    }

    .shape-3 {
        width: 250px;
        height: 250px;
        background: #ec4899;
        top: 50%;
        right: -100px;
    }

    .ctaFinal__content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    .ctaFinal__content h2 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #e8f3ff 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.3;
    }

    .ctaFinal__content p {
        font-size: 1.1rem;
        color: #b0b0b0;
        margin-bottom: 40px;
        line-height: 1.8;
    }

    .ctaFinal__button {
        display: inline-block;
        padding: 16px 40px;
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: white;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(96, 165, 250, 0.3);
        border: 2px solid transparent;
    }

    .ctaFinal__button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(96, 165, 250, 0.4);
    }

    @media (max-width: 768px) {
        .ctaFinal {
            padding: 60px 20px;
            margin: 60px 0 0 0;
        }

        .ctaFinal__content h2 {
            font-size: 1.8rem;
        }

        .ctaFinal__content p {
            font-size: 1rem;
        }
    }
</style>
