---
import { getDictionary, getLocaleFromPath } from '../../i18n';
import { localizedPage } from '../../lib/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---

<section class="ctaFinal">
    <div class="ctaFinal__background">
        <div class="ctaFinal__shape shape-1"></div>
        <div class="ctaFinal__shape shape-2"></div>
        <div class="ctaFinal__shape shape-3"></div>
    </div>
    <div class="ctaFinal__content">
        <h2>{dict.servicesGeneral.cta.title}</h2>
        <p>{dict.servicesGeneral.cta.subtitle}</p>
        <a href={localizedPage(locale, 'contact')} class="ctaFinal__button">{dict.servicesGeneral.cta.button}</a>
    </div>
</section>

<style>
    .ctaFinal {
        position: relative;
        padding: 100px 20px;
        margin: 100px 0 0 0;
        overflow: hidden;
        background: linear-gradient(180deg, var(--bg-base) 0%, rgba(20, 10, 40, 0.8) 100%);
    }

    .ctaFinal__background {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    }

    .ctaFinal__shape {
        position: absolute;
        border-radius: 50%;
        opacity: 0.08;
    }

    .shape-1 {
        width: 400px;
        height: 400px;
        background: #60a5fa;
        top: -150px;
        left: -150px;
    }

    .shape-2 {
        width: 300px;
        height: 300px;
        background: #8b5cf6;
        bottom: 50px;
        right: 10%;
    }

    .shape-3 {
        width: 250px;
        height: 250px;
        background: #ec4899;
        top: 50%;
        right: -100px;
    }

    .ctaFinal__content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    .ctaFinal__content h2 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin-bottom: var(--sp-5);
        background: linear-gradient(135deg, #e8f3ff 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.3;
    }

    .ctaFinal__content p {
        font-size: var(--text-lg);
        color: var(--txt-muted);
        margin-bottom: var(--sp-10);
        line-height: 1.8;
    }

    .ctaFinal__button {
        display: inline-block;
        padding: var(--sp-4) var(--sp-10);
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: var(--txt-primary);
        font-weight: 700;
        font-size: var(--text-md);
        border-radius: var(--rad-sm);
        text-decoration: none;
        transition: var(--transition-base);
        box-shadow: 0 10px 30px rgba(96, 165, 250, 0.3);
        border: 2px solid transparent;
    }

    @media (hover: hover) {
        .ctaFinal__button:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(96, 165, 250, 0.4);
        }
    }

    /* ── Tablet */
    @media (max-width: 1024px) {
        .ctaFinal {
            padding: var(--sp-20) 6vw;
            margin: var(--sp-20) 0 0 0;
        }

        .shape-1 {
            width: 280px;
            height: 280px;
        }

        .shape-2 {
            width: 220px;
            height: 220px;
        }

        .shape-3 {
            width: 180px;
            height: 180px;
        }
    }

    /* ── Mobile */
    @media (max-width: 768px) {
        .ctaFinal {
            padding: 60px 6vw;
            margin: 60px 0 0 0;
        }

        .ctaFinal__content h2 {
            font-size: clamp(1.6rem, 5vw, 2rem);
        }

        .ctaFinal__content p {
            font-size: var(--text-md);
        }

        .ctaFinal__button {
            display: block;
            width: 100%;
            max-width: 320px;
            margin: 0 auto;
            text-align: center;
            padding: var(--sp-4) var(--sp-5);
        }

        .shape-1 {
            width: 200px;
            height: 200px;
            top: -80px;
            left: -80px;
        }

        .shape-2 {
            width: 160px;
            height: 160px;
        }

        .shape-3 {
            width: 140px;
            height: 140px;
        }
    }

    /* ── Small mobile */
    @media (max-width: 480px) {
        .ctaFinal {
            padding: var(--sp-12) var(--px);
            margin: var(--sp-12) 0 0 0;
        }

        .ctaFinal__content h2 {
            font-size: clamp(1.3rem, 7vw, 1.6rem);
        }

        .ctaFinal__content p {
            font-size: var(--text-base);
        }

        .ctaFinal__button {
            max-width: 100%;
        }

        .shape-1,
        .shape-2,
        .shape-3 {
            display: none;
        }
    }
</style>
