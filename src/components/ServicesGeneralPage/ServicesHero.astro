---
---

<section class="servicesHero">
    <div class="servicesHero__content">
        <div class="servicesHero__badge">
            <span>🚀 Servicios Digitales</span>
        </div>
        <h1 class="servicesHero__title">Llevamos tu presencia digital al siguiente nivel</h1>
        <p class="servicesHero__description">
            Diseñamos soluciones web personalizadas que convierten visitantes en clientes. 
            Desde landing pages de alto impacto hasta tiendas online robustas, tenemos el 
            servicio perfecto para tu negocio.
        </p>
        <div class="servicesHero__cta">
            <a href="#services" class="servicesHero__button primary">Explorar Servicios</a>
            <a href="#contact" class="servicesHero__button secondary">Contáctanos</a>
        </div>
    </div>
    <div class="servicesHero__decorative">
        <div class="servicesHero__gridfx"></div>
        <div class="servicesHero__shape shape-1"></div>
        <div class="servicesHero__shape shape-2"></div>
        <div class="servicesHero__shape shape-3"></div>
        <div class="servicesHero__illustration" aria-hidden="true"></div>
        <div class="servicesHero__illustrationBlend"></div>
        <div class="servicesHero__glow"></div>
    </div>
</section>

<style>
    .servicesHero {
        position: relative;
        min-height: 100dvh;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 100px 8vw 80px;
        overflow: hidden;
        background: linear-gradient(180deg, rgba(6, 3, 19, 1) 0%, rgba(20, 10, 40, 0.8) 100%);
    }

    .servicesHero__content {
        position: relative;
        z-index: 2;
        text-align: left;
        max-width: 800px;
        animation: fadeInUp 1s ease-out;
    }

    .servicesHero__badge {
        display: inline-block;
        padding: 10px 20px;
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.2), rgba(139, 92, 246, 0.2));
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 20px;
        margin-bottom: 30px;
        font-size: 0.9rem;
        color: #60a5fa;
        font-weight: 600;
    }

    .servicesHero__title {
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 800;
        margin-bottom: 30px;
        background: linear-gradient(135deg, #e8f3ff 0%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
    }

    .servicesHero__description {
        font-size: 1.1rem;
        color: #b0b0b0;
        margin-bottom: 50px;
        line-height: 1.8;
        max-width: 640px;
    }

    .servicesHero__cta {
        display: flex;
        gap: 20px;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    .servicesHero__button {
        padding: 14px 32px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        border: 2px solid transparent;
    }

    .servicesHero__button.primary {
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: white;
        box-shadow: 0 8px 20px rgba(96, 165, 250, 0.3);
    }

    .servicesHero__button.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(96, 165, 250, 0.4);
    }

    .servicesHero__button.secondary {
        background: transparent;
        color: #60a5fa;
        border-color: #60a5fa;
    }

    .servicesHero__button.secondary:hover {
        background: rgba(96, 165, 250, 0.1);
        transform: translateY(-2px);
    }

    .servicesHero__decorative {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: 1;
        pointer-events: none;
    }

    .servicesHero__gridfx {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.9), transparent 75%);
        opacity: 0.25;
    }

    .servicesHero__shape {
        position: absolute;
        border-radius: 50%;
        opacity: 0.11;
        filter: blur(2px);
        animation: floatShape 10s ease-in-out infinite;
    }

    .shape-1 {
        width: 300px;
        height: 300px;
        background: #60a5fa;
        top: -100px;
        right: -100px;
        animation-delay: 0s;
    }

    .shape-2 {
        width: 200px;
        height: 200px;
        background: #8b5cf6;
        bottom: 100px;
        left: -50px;
        animation-delay: 1.8s;
    }

    .shape-3 {
        width: 250px;
        height: 250px;
        background: #ec4899;
        bottom: -100px;
        right: 10%;
        animation-delay: 3.2s;
    }

    .servicesHero__illustration {
        position: absolute;
        right: 2%;
        bottom: -4%;
        width: min(620px, 46vw);
        height: min(560px, 78dvh);
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.15), rgba(139, 92, 246, 0.12)) center/cover,
                    url('https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1400&q=80') center/cover;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        border-radius: 14px;
        opacity: 0.9;
        mix-blend-mode: lighten;
        filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.28)) saturate(1.2) brightness(1.05);
        mask-image: radial-gradient(circle at 55% 50%, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.85) 45%, rgba(0, 0, 0, 0.4) 75%, transparent 100%);
        -webkit-mask-image: radial-gradient(circle at 55% 50%, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.85) 45%, rgba(0, 0, 0, 0.4) 75%, transparent 100%);
        transform: translateY(0px);
        animation: floatIllustration 7s ease-in-out infinite;
    }

    .servicesHero__illustrationBlend {
        position: absolute;
        right: 0;
        bottom: -10%;
        width: min(680px, 52vw);
        height: min(640px, 88dvh);
        background:
            radial-gradient(circle at 42% 42%, rgba(96, 165, 250, 0.24), rgba(96, 165, 250, 0) 62%),
            radial-gradient(circle at 72% 72%, rgba(139, 92, 246, 0.22), rgba(139, 92, 246, 0) 60%),
            linear-gradient(135deg, rgba(6, 3, 19, 0.1), rgba(20, 10, 40, 0.6));
        mix-blend-mode: soft-light;
        filter: blur(18px);
        opacity: 0.72;
        mask-image: radial-gradient(circle at 58% 50%, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.55) 60%, transparent 100%);
        -webkit-mask-image: radial-gradient(circle at 58% 50%, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.55) 60%, transparent 100%);
    }

    .servicesHero__glow {
        position: absolute;
        width: 420px;
        height: 420px;
        right: -120px;
        bottom: -180px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(96, 165, 250, 0.25) 0%, rgba(96, 165, 250, 0) 70%);
        filter: blur(10px);
        animation: pulseGlow 5s ease-in-out infinite;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes floatShape {
        0%, 100% {
            transform: translateY(0px) translateX(0px);
        }
        50% {
            transform: translateY(-12px) translateX(8px);
        }
    }

    @keyframes floatIllustration {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-14px);
        }
    }

    @keyframes pulseGlow {
        0%, 100% {
            opacity: 0.65;
        }
        50% {
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        .servicesHero {
            padding: 60px 20px;
            min-height: 100dvh;
            height: 100dvh;
        }

        .servicesHero__title {
            font-size: 2rem;
        }

        .servicesHero__description {
            font-size: 1rem;
        }

        .servicesHero__cta {
            flex-direction: column;
            align-items: flex-start;
        }

        .servicesHero__button {
            width: 100%;
            max-width: 300px;
        }

        .servicesHero__illustration {
            width: min(320px, 64vw);
            height: min(320px, 42dvh);
            right: -24px;
            bottom: 6%;
            opacity: 0.38;
        }

        .servicesHero__illustrationBlend {
            width: min(360px, 70vw);
            height: min(360px, 48dvh);
            right: -24px;
            bottom: 5%;
            opacity: 0.82;
        }

        .servicesHero__glow {
            width: 280px;
            height: 280px;
            right: -90px;
            bottom: -110px;
        }

        .servicesHero__gridfx {
            background-size: 34px 34px;
        }
    }
</style>
