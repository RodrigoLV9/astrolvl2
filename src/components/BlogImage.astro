---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 900px) 100vw, 900px',
} = Astro.props as Props;
---

<Image
  src={src}
  alt={alt}
  loading={loading}
  widths={[640, 960, 1280, 1600]}
  sizes={sizes}
  quality={78}
  format="webp"
/>
