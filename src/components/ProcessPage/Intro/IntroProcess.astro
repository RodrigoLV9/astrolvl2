---
import { CardIntroProcess } from './CardIntroProcess.tsx';
import { getDictionary, getLocaleFromPath } from '../../../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---
<section class="introProcess">
    <div class="introProcess__label">
        <span class="introProcess__label-dot"></span>
        <p>{dict.processPage.intro.label}</p>
    </div>

    <div class="introProcess__text">
        <h2>{dict.processPage.intro.titleStart} <span class="introProcess__gradient">{dict.processPage.intro.titleHighlight}</span></h2>
        <p>{dict.processPage.intro.subtitle}</p>
    </div>

    <div class="introProcess__cards">
        {dict.processPage.intro.cards.map((card) => (
            <CardIntroProcess client:load {...card} />
        ))}
    </div>

    <div class="introProcess__features">
        {dict.processPage.intro.features.map((f) => (
            <div class="introProcess__feature">
                <span class="introProcess__feature-icon">{f.icon}</span>
                <span class="introProcess__feature-label">{f.label}</span>
            </div>
        ))}
    </div>
</section>

<style>
    .introProcess {
        padding: 100px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: linear-gradient(180deg, var(--bg-section) 0%, var(--bg-light) 100%);
    }

    /* Badge */
    .introProcess__label {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--clr-primary-a10);
        border: 1px solid var(--border-primary);
        border-radius: var(--rad-pill);
        padding: 6px 18px;
        margin-bottom: 28px;
    }
    .introProcess__label p {
        color: var(--txt-purple);
        font-size: var(--text-sm);
        font-weight: 500;
        margin: 0;
    }
    .introProcess__label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--clr-blue);
        animation: introPulse 2s ease-in-out infinite;
    }
    @keyframes introPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(0.7); }
    }

    /* Heading */
    .introProcess__text {
        text-align: center;
        margin-bottom: 64px;
        max-width: 600px;
    }
    .introProcess__text h2 {
        font-size: 2.6rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        line-height: 1.15;
        margin-bottom: 14px;
        color: var(--txt-primary);
    }
    .introProcess__gradient {
        background: var(--grad-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .introProcess__text p {
        color: var(--txt-dim);
        font-size: var(--text-md);
        line-height: 1.7;
    }

    /* Cards grid */
    .introProcess__cards {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        width: 100%;
        max-width: 1100px;
        margin-bottom: 52px;
    }

    /* Features strip */
    .introProcess__features {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .introProcess__feature {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--rad-pill);
        padding: 10px 22px;
        transition: border-color 0.3s, background 0.3s;
    }
    .introProcess__feature:hover {
        background: var(--clr-primary-a10);
        border-color: var(--border-primary);
    }
    .introProcess__feature-icon {
        font-size: 1.1rem;
        line-height: 1;
    }
    .introProcess__feature-label {
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--txt-secondary);
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .introProcess { padding: 70px 20px; }
        .introProcess__text { margin-bottom: 48px; }
        .introProcess__text h2 { font-size: 1.9rem; }
        .introProcess__cards { gap: 14px; margin-bottom: 40px; }
    }

    @media (max-width: 480px) {
        .introProcess { padding: 60px 16px; }
        .introProcess__text h2 { font-size: 1.6rem; }
        .introProcess__text { margin-bottom: 36px; max-width: 100%; }
        .introProcess__features { gap: 8px; }
        .introProcess__feature { padding: 8px 16px; }
        .introProcess__feature-label { font-size: 0.82rem; }
    }
</style>