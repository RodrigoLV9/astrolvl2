---
import { getDictionary, getLocaleFromPath } from '../../../i18n';
import { localizedPage } from '../../../lib/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const contactHref = localizedPage(locale, 'contact');
---

<section class="faqs2">
  <div class="faqs2__inner">

    <div class="faqs2__left">
      <p class="faqs2__eyebrow">{dict.processPage.faqs.eyebrow}</p>
      <h2 class="faqs2__title">{dict.processPage.faqs.title}</h2>
      <p class="faqs2__subtitle">
        {dict.processPage.faqs.subtitleLine1}
        {" "}
        {dict.processPage.faqs.subtitleLine2}
      </p>
      <a href={contactHref} class="faqs2__cta">{dict.processPage.faqs.cta} &rarr;</a>
    </div>

    <div class="faqs2__right">
      {dict.processPage.faqs.items.map((faq, i) => (
        <div class="faq2-item">
          <div class="faq2-item__question">
            <img
              src="/src/assets/images/question-circle2.svg"
              alt=""
              width="18"
              height="18"
              aria-hidden="true"
            />
            <h4>{faq.question}</h4>
          </div>
          <p class="faq2-item__answer">{faq.answer}</p>
          {i < dict.processPage.faqs.items.length - 1 && <div class="faq2-item__divider" />}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .faqs2 {
    padding: 100px 20px;
    background: linear-gradient(180deg, var(--bg-section) 0%, var(--bg-light) 100%);
  }

  .faqs2__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 80px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  /* Left column */
  .faqs2__left {
    position: sticky;
    top: 100px;
  }

  .faqs2__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--clr-purple);
    margin: 0 0 20px;
  }

  .faqs2__title {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.8px;
    color: var(--txt-primary);
    margin: 0 0 20px;
  }

  .faqs2__subtitle {
    font-size: 0.9rem;
    color: var(--txt-dim);
    line-height: 1.75;
    margin: 0 0 32px;
  }

  .faqs2__cta {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--txt-muted);
    text-decoration: none;
    letter-spacing: 0.3px;
  }

  /* Right column — FAQ list */
  .faqs2__right {
    display: flex;
    flex-direction: column;
  }

  .faq2-item {
    padding: 28px 0;
  }

  .faq2-item__question {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }

  .faq2-item__question img {
    margin-top: 3px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .faq2-item__question h4 {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    line-height: 1.5;
    letter-spacing: -0.1px;
  }

  .faq2-item__answer {
    font-size: 0.875rem;
    color: var(--txt-dim);
    line-height: 1.75;
    margin: 0;
    padding-left: 30px;
  }

  .faq2-item__divider {
    height: 1px;
    background: var(--border-subtle);
    margin-top: 28px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .faqs2 { padding: 70px 20px; }
    .faqs2__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .faqs2__left {
      position: static;
    }
    .faqs2__title {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .faqs2 { padding: 60px 16px; }
    .faqs2__title { font-size: 1.65rem; letter-spacing: -0.4px; }
    .faqs2__eyebrow { font-size: var(--text-xs); }
    .faqs2__subtitle { font-size: var(--text-sm); }
    .faq2-item { padding: 20px 0; }
    .faq2-item__question h4 { font-size: var(--text-sm); }
    .faq2-item__answer {
      font-size: var(--text-sm);
      padding-left: 0;
    }
    .faq2-item__question { gap: 8px; }
    .faq2-item__divider { margin-top: 20px; }
  }
</style>