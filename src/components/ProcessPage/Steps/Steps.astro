---
import StepCard from "./StepCard.astro";
import { processStepsData } from '../../../data/generalData.js';
---

<section class="steps">
  <div class="steps__label">
    <span class="steps__label-dot"></span>
    <p>Paso a paso</p>
  </div>
  <div class="steps__heading">
    <h2>Etapas del <span class="steps__gradient">Proceso</span></h2>
    <p>Cada fase está diseñada para maximizar la calidad y minimizar los riesgos</p>
  </div>

  <div class="steps__timeline">
    {processStepsData.map((step, i) => (
      <div class={`step-row ${i % 2 !== 0 ? 'step-row--right' : ''}`}>
        <div class="step-row__card">
          <StepCard {...step} />
        </div>
        <div class="step-row__center">
          <div class="step-row__dot" style={`background: ${step.accent}`}>
            <span>{step.icon}</span>
          </div>
        </div>
        <div class="step-row__spacer" />
      </div>
    ))}
  </div>
</section>

<style>
  .steps {
    padding: 100px 20px;
    background: linear-gradient(180deg, var(--bg-light) 0%, var(--bg-section) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Badge */
  .steps__label {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--clr-primary-a10);
    border: 1px solid var(--border-primary);
    border-radius: var(--rad-pill);
    padding: 6px 18px;
    margin-bottom: 28px;
  }
  .steps__label p { color: var(--txt-purple); font-size: var(--text-sm); font-weight: 500; margin: 0; }
  .steps__label-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--clr-blue);
    animation: stepsPulse 2s ease-in-out infinite;
  }
  @keyframes stepsPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.7); }
  }

  /* Heading */
  .steps__heading {
    text-align: center;
    margin-bottom: 80px;
    max-width: 600px;
  }
  .steps__heading h2 {
    font-size: 2.6rem; font-weight: 800; letter-spacing: -0.5px;
    line-height: 1.15; margin-bottom: 14px; color: var(--txt-primary);
  }
  .steps__gradient {
    background: var(--grad-primary);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .steps__heading p { color: var(--txt-dim); font-size: var(--text-md); line-height: 1.7; }

  /* Timeline wrapper */
  .steps__timeline {
    width: 100%;
    max-width: 1100px;
    position: relative;
  }

  /* Continuous gradient line */
  .steps__timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-1px);
    top: 28px;
    bottom: 28px;
    width: 2px;
    background: linear-gradient(180deg, #667eea 0%, #f093fb 25%, #4facfe 50%, #43e97b 75%, #fa709a 100%);
    z-index: 0;
  }

  /* Each step row */
  .step-row {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    grid-template-areas: "card center spacer";
    align-items: start;
    margin-bottom: 40px;
  }
  .step-row--right { grid-template-areas: "spacer center card"; }
  .step-row:last-child { margin-bottom: 0; }

  .step-row__card   { grid-area: card;   padding: 0 28px; }
  .step-row__center { grid-area: center; display: flex; justify-content: center; padding-top: 6px; position: relative; z-index: 1; }
  .step-row__spacer { grid-area: spacer; }

  /* Dot */
  .step-row__dot {
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem; line-height: 1; flex-shrink: 0;
    box-shadow: 0 0 0 6px rgba(255,255,255,0.04), 0 0 0 14px rgba(255,255,255,0.015), 0 8px 24px rgba(0,0,0,0.4);
  }

  /* Tablet: single-column layout with dot on the left */
  @media (max-width: 768px) {
    .steps { padding: 70px 20px; }
    .steps__heading { margin-bottom: 56px; }
    .steps__heading h2 { font-size: 1.9rem; }
    .steps__timeline::before { left: 26px; }
    .step-row,
    .step-row--right {
      grid-template-columns: 52px 1fr;
      grid-template-areas: "center card";
    }
    .step-row__spacer { display: none; }
    .step-row__dot { width: 40px; height: 40px; font-size: 1rem; }
    .step-row__card { padding: 0 0 0 16px; }
    .step-row { margin-bottom: 28px; }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .steps { padding: 60px 16px; }
    .steps__heading h2 { font-size: 1.6rem; }
    .steps__heading { margin-bottom: 40px; }
    .steps__timeline::before { left: 20px; }
    .step-row,
    .step-row--right {
      grid-template-columns: 44px 1fr;
    }
    .step-row__dot { width: 36px; height: 36px; font-size: 0.9rem; }
    .step-row__card { padding: 0 0 0 12px; }
  }
</style>