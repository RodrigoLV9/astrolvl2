---
import StepCard from "./StepCard.astro"
import TimeLine from "./TimeLine.astro"
---
<section class="steps">
    <h1>Etapas del proceso</h1>
    <div class="steps__timeline">
        <StepCard/>
        <StepCard/>
        <StepCard/>
        <StepCard/>
    </div>
    <TimeLine/>
</section>
<style>
    .steps{
        position: relative;
        height: 1500px;
    }
    .steps h1{
        text-align: center;
    }
    .steps__timeline{
        height: 1300px;
        position: absolute;
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        width: 70vw;
        margin:auto
    }
</style>