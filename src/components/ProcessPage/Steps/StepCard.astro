---
interface Props {
  number: number;
  icon: string;
  title: string;
  duration: string;
  description: string;
  items: string[];
  accent: string;
}

const { number, title, duration, description, items, accent } = Astro.props;
---

<article class="stepCard">
  <header class="stepCard__header">
    <span class="stepCard__number">0{number}</span>
    <span class="stepCard__duration">{duration}</span>
  </header>
  <h3 class="stepCard__title">{title}</h3>
  <p class="stepCard__desc">{description}</p>
  <ul class="stepCard__list">
    {items.map(item => (
      <li class="stepCard__item">
        <span class="stepCard__bullet" style={`background: ${accent}`} />
        {item}
      </li>
    ))}
  </ul>
  <div class="stepCard__bar" style={`background: ${accent}`} />
</article>

<style>
  .stepCard {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: 26px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.35s, transform 0.35s;
  }
  .stepCard:hover {
    border-color: rgba(255, 255, 255, 0.13);
    transform: translateY(-3px);
  }

  .stepCard__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .stepCard__number {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.25);
    text-transform: uppercase;
  }
  .stepCard__duration {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 100px;
    padding: 3px 12px;
  }

  .stepCard__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }
  .stepCard__desc {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.65;
    margin: 0 0 18px;
  }

  .stepCard__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stepCard__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.65);
  }
  .stepCard__bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Accent bar */
  .stepCard__bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    opacity: 0.55;
    transition: opacity 0.35s;
  }
  .stepCard:hover .stepCard__bar { opacity: 1; }
</style>