---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";
import { getDictionary, getLocaleFromPath } from "../../i18n";
import { localizedBlogPost } from "../../lib/routes";

const blogEntries = await getCollection("blog");
const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const localizedEntries = blogEntries.filter((entry) =>
    locale === "en" ? entry.id.startsWith("en/") : entry.id.startsWith(`${locale}/`)
);
const sortedBlogs = [...localizedEntries].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fallbackImage = "/src/assets/images/blog/img-blog-1-main.jpg";

const estimateReadingTime = (content: string) => {
    const words = content.trim().split(/\s+/).length;
    return Math.max(1, Math.ceil(words / 200));
};

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat(locale === "en" ? "en-US" : locale === "pt" ? "pt-PT" : "es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    }).format(date);

const cards = sortedBlogs.map((blog) => ({
    title: blog.data.title,
    description: blog.data.description,
    image: blog.data.coverImage?.src ?? blog.data.image?.src ?? fallbackImage,
    href: localizedBlogPost(locale, blog.slug),
    readTimeText: `${estimateReadingTime(blog.body)} min`,
    dateText: formatDate(blog.data.pubDate),
    readArticleAria: dict.blog.readArticleAria,
}));
---
<section class="latestBlogs">
    <div class="latestBlogs__bg">
        <div class="latestBlogs__grid-bg"></div>
        <div class="latestBlogs__orb latestBlogs__orb--1"></div>
        <div class="latestBlogs__orb latestBlogs__orb--2"></div>
    </div>

    <div class="latestBlogs__inner">
        <header class="latestBlogs__header">
            <span class="latestBlogs__eyebrow">{dict.blog.eyebrow}</span>
            <h2 class="latestBlogs__title">{dict.blog.latestTitle}</h2>
            <p class="latestBlogs__subtitle">
                {dict.blog.latestSubtitle}
            </p>
        </header>

        <div class="latestBlogs__cards">
            {cards.map((card) => (
                <BlogCard {...card} />
            ))}
        </div>
    </div>
</section>

<style>
    .latestBlogs {
        position: relative;
        padding: 100px 0 120px;
        overflow: hidden;
    }

    /* Background */
    .latestBlogs__bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .latestBlogs__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(99, 102, 241, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99, 102, 241, 0.035) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, black 20%, transparent 100%);
        -webkit-mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, black 20%, transparent 100%);
    }
    .latestBlogs__orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(110px);
    }
    .latestBlogs__orb--1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.13), transparent 70%);
        top: -100px;
        right: -100px;
    }
    .latestBlogs__orb--2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.09), transparent 70%);
        bottom: -80px;
        left: -80px;
    }

    /* Inner */
    .latestBlogs__inner {
        position: relative;
        z-index: 1;
        width: 80vw;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Header */
    .latestBlogs__header {
        text-align: center;
        margin-bottom: 44px;
        animation: lbFadeUp 0.6s ease both;
    }
    .latestBlogs__eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--clr-primary-dull);
        background: var(--clr-primary-a10);
        border: 1px solid rgba(99, 102, 241, 0.25);
        padding: 4px 14px;
        border-radius: var(--rad-pill);
        margin-bottom: 18px;
    }
    .latestBlogs__title {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 700;
        color: rgba(255, 255, 255, 0.95);
        margin: 0 0 14px;
        line-height: 1.2;
    }
    .latestBlogs__subtitle {
        font-size: 1rem;
        color: rgba(148, 163, 184, 0.8);
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.65;
    }

    /* Cards grid */
    .latestBlogs__cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 28px;
        align-items: start;
        animation: lbFadeUp 0.6s ease both 0.2s;
    }

    @keyframes lbFadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
        .latestBlogs__inner {
            width: 90vw;
        }
        .latestBlogs__cards {
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }
    }

    @media (max-width: 768px) {
        .latestBlogs {
            padding: 70px 0 80px;
        }
        .latestBlogs__header {
            margin-bottom: 32px;
        }
        .latestBlogs__subtitle {
            font-size: var(--text-base);
        }
    }

    @media (max-width: 480px) {
        .latestBlogs {
            padding: 56px 0 60px;
        }
        .latestBlogs__inner {
            width: 92vw;
        }
        .latestBlogs__cards {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>