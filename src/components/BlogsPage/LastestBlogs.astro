---
import BlogCard from "./BlogCard.astro";
import { blogCategoriesData } from "../../data/generalData.js";
---
<section class="latestBlogs">
    <div class="latestBlogs__bg">
        <div class="latestBlogs__grid-bg"></div>
        <div class="latestBlogs__orb latestBlogs__orb--1"></div>
        <div class="latestBlogs__orb latestBlogs__orb--2"></div>
    </div>

    <div class="latestBlogs__inner">
        <header class="latestBlogs__header">
            <span class="latestBlogs__eyebrow">Blog</span>
            <h2 class="latestBlogs__title">Últimos artículos</h2>
            <p class="latestBlogs__subtitle">
                Explora contenido sobre desarrollo web, diseño y las últimas tendencias en tecnología.
            </p>
        </header>

        <div class="latestBlogs__filters" role="tablist" aria-label="Filtrar por categoría">
            {blogCategoriesData.map((cat, i) => (
                <button
                    class={`latestBlogs__filter${i === 0 ? " latestBlogs__filter--active" : ""}`}
                    role="tab"
                    aria-selected={i === 0 ? "true" : "false"}
                >
                    {cat}
                </button>
            ))}
        </div>

        <div class="latestBlogs__cards">
            <BlogCard/>
            <BlogCard/>
            <BlogCard/>
            <BlogCard/>
            <BlogCard/>
            <BlogCard/>
        </div>

        <div class="latestBlogs__footer">
            <a href="#" class="latestBlogs__view-all">
                Ver todos los artículos
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    .latestBlogs {
        position: relative;
        padding: 100px 0 120px;
        overflow: hidden;
    }

    /* Background */
    .latestBlogs__bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .latestBlogs__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(99, 102, 241, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99, 102, 241, 0.035) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, black 20%, transparent 100%);
        -webkit-mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, black 20%, transparent 100%);
    }
    .latestBlogs__orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(110px);
    }
    .latestBlogs__orb--1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.13), transparent 70%);
        top: -100px;
        right: -100px;
    }
    .latestBlogs__orb--2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.09), transparent 70%);
        bottom: -80px;
        left: -80px;
    }

    /* Inner */
    .latestBlogs__inner {
        position: relative;
        z-index: 1;
        width: 80vw;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Header */
    .latestBlogs__header {
        text-align: center;
        margin-bottom: 44px;
        animation: lbFadeUp 0.6s ease both;
    }
    .latestBlogs__eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--clr-primary-dull);
        background: var(--clr-primary-a10);
        border: 1px solid rgba(99, 102, 241, 0.25);
        padding: 4px 14px;
        border-radius: var(--rad-pill);
        margin-bottom: 18px;
    }
    .latestBlogs__title {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 700;
        color: rgba(255, 255, 255, 0.95);
        margin: 0 0 14px;
        line-height: 1.2;
    }
    .latestBlogs__subtitle {
        font-size: 1rem;
        color: rgba(148, 163, 184, 0.8);
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.65;
    }

    /* Filters */
    .latestBlogs__filters {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 52px;
        animation: lbFadeUp 0.6s ease both 0.1s;
    }
    .latestBlogs__filter {
        padding: 7px 18px;
        border-radius: var(--rad-pill);
        border: 1px solid var(--border-soft);
        background: var(--bg-card);
        color: rgba(148, 163, 184, 0.8);
        font-size: 13px;
        cursor: pointer;
        transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }
    .latestBlogs__filter:hover {
        border-color: rgba(129, 140, 248, 0.4);
        color: rgba(165, 180, 252, 0.95);
        background: rgba(99, 102, 241, 0.08);
    }
    .latestBlogs__filter--active {
        border-color: rgba(99, 102, 241, 0.5);
        background: rgba(99, 102, 241, 0.15);
        color: var(--clr-primary-pale);
        box-shadow: 0 0 16px rgba(99, 102, 241, 0.15);
    }

    /* Cards grid */
    .latestBlogs__cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 28px;
        align-items: start;
        animation: lbFadeUp 0.6s ease both 0.2s;
    }

    /* Footer CTA */
    .latestBlogs__footer {
        display: flex;
        justify-content: center;
        margin-top: 56px;
        animation: lbFadeUp 0.6s ease both 0.3s;
    }
    .latestBlogs__view-all {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        border-radius: var(--rad-sm);
        border: 1px solid rgba(99, 102, 241, 0.35);
        background: var(--clr-primary-a10);
        color: var(--clr-primary-pale);
        font-size: var(--text-sm);
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }
    .latestBlogs__view-all:hover {
        border-color: rgba(99, 102, 241, 0.6);
        background: rgba(99, 102, 241, 0.18);
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(99, 102, 241, 0.2);
    }
    .latestBlogs__view-all svg {
        transition: transform 0.25s ease;
        flex-shrink: 0;
    }
    .latestBlogs__view-all:hover svg {
        transform: translateX(4px);
    }

    @keyframes lbFadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
        .latestBlogs__inner {
            width: 90vw;
        }
        .latestBlogs__cards {
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }
    }

    @media (max-width: 768px) {
        .latestBlogs {
            padding: 70px 0 80px;
        }
        .latestBlogs__header {
            margin-bottom: 32px;
        }
        .latestBlogs__subtitle {
            font-size: var(--text-base);
        }
        .latestBlogs__filters {
            gap: 8px;
            margin-bottom: 36px;
        }
    }

    @media (max-width: 480px) {
        .latestBlogs {
            padding: 56px 0 60px;
        }
        .latestBlogs__inner {
            width: 92vw;
        }
        .latestBlogs__cards {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .latestBlogs__filter {
            font-size: var(--text-xs);
            padding: 6px 14px;
        }
        .latestBlogs__view-all {
            width: 100%;
            justify-content: center;
        }
    }
</style>