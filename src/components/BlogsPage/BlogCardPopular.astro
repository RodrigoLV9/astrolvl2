---
import { BlogPopularFooter } from './BlogPopularFooter';

interface Props {
    title: string;
    image: string;
    href: string;
    readTimeText: string;
    dateText: string;
}

const { title, image, href, readTimeText, dateText } = Astro.props as Props;
---
<a class="blogCardPopular" href={href} aria-label={`Ir al blog: ${title}`}>
    <div class="blogCardPopular__media">
        <img src={image} alt={title} loading="lazy" />
    </div>
    <div class="blogCardPopular__text">
        <p>{title}</p>
        <BlogPopularFooter readTimeText={readTimeText} dateText={dateText} />
    </div>
</a>
<style>
    .blogCardPopular {
        display: flex;
        gap: 15px;
        align-items: center;
        padding: 12px 14px;
        border-radius: var(--rad-sm);
        border: 1px solid var(--border-subtle);
        background: var(--bg-card);
        position: relative;
        overflow: hidden;
        cursor: pointer;
        animation: popFadeUp 0.55s ease both;
        transition: border-color 0.3s ease, background 0.3s ease,
                    transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
    }
    .blogCardPopular::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, var(--clr-primary), #a855f7);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .blogCardPopular:hover {
        border-color: rgba(129, 140, 248, 0.28);
        background: rgba(99, 102, 241, 0.05);
        transform: translateX(4px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
    }
    .blogCardPopular:hover::before {
        opacity: 1;
    }
    .blogCardPopular__media {
        width: 130px;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--rad-xs);
        flex-shrink: 0;
    }
    .blogCardPopular__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }
    .blogCardPopular:hover .blogCardPopular__media img {
        transform: scale(1.05);
    }
    .blogCardPopular__text {
        min-height: 98px;
        padding: 6px 2px 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
    }
    .blogCardPopular__text p {
        font-size: var(--text-sm);
        font-weight: 500;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.88);
        margin-bottom: 8px;
    }
    @keyframes popFadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ── */
    @media (max-width: 480px) {
        .blogCardPopular__media {
            width: 90px;
            aspect-ratio: 4 / 3;
        }
        .blogCardPopular__text {
            height: auto;
            min-height: 90px;
        }
    }
</style>