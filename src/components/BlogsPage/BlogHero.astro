---
import { Search } from "./Search"
import { BlogCardMain } from './BlogCardMain.tsx'
import BlogCardPopular from "./BlogCardPopular.astro"
---
<section class="blogHero">
    <div class="blogHero__bg">
        <div class="blogHero__grid"></div>
        <div class="blogHero__orb blogHero__orb--1"></div>
        <div class="blogHero__orb blogHero__orb--2"></div>
        <div class="blogHero__orb blogHero__orb--3"></div>
    </div>

    <div class="blogHero__topbar">
        <Search client:load />
    </div>

    <div class="blogHero__content">
        <BlogCardMain />
        <aside class="blogHero__sidebar">
            <h4 class="blogHero__sidebar-title">
                <span class="blogHero__sidebar-dot"></span>
                Lo más leído
            </h4>
            <div class="blogHero__sidebar-list">
                <BlogCardPopular />
                <BlogCardPopular />
                <BlogCardPopular />
            </div>
        </aside>
    </div>
</section>

<style>
    .blogHero {
        position: relative;
        min-height: 100dvh;
        width: 100%;
        padding: 110px 7vw 56px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* ── Background ── */
    .blogHero__bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .blogHero__grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(99,102,241,0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99,102,241,0.04) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, black 20%, transparent 100%);
        -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, black 20%, transparent 100%);
    }
    .blogHero__orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
    }
    .blogHero__orb--1 {
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(99,102,241,0.22), transparent 70%);
        top: -300px;
        left: -200px;
        animation: orbFloat 14s ease-in-out infinite;
    }
    .blogHero__orb--2 {
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, rgba(168,85,247,0.17), transparent 70%);
        bottom: -140px;
        right: -140px;
        animation: orbFloat 18s ease-in-out infinite reverse 2s;
    }
    .blogHero__orb--3 {
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgba(59,130,246,0.13), transparent 70%);
        top: 42%;
        left: 46%;
        animation: orbFloat 22s ease-in-out infinite 5s;
    }
    @keyframes orbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33%       { transform: translate(-22px, -30px) scale(1.06); }
        66%       { transform: translate(18px, 20px) scale(0.95); }
    }

    /* ── Top bar ── */
    .blogHero__topbar {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        animation: fadeSlideDown 0.5s ease both;
    }
    .blogHero__topbar :global(.blogSearch) {
        max-width: 680px;
    }

    /* ── Content grid ── */
    .blogHero__content {
        position: relative;
        z-index: 1;
        /* flex: 1; */
        display: flex;
        /* align-items: stretch; */
        gap: 22px;
        /* min-height: 0; */
        margin:auto
    }

    /* ── Sidebar ── */
    .blogHero__sidebar {
        display: flex;
        flex-direction: column;
        animation: fadeSlideRight 0.65s ease both 0.3s;
    }
    .blogHero__sidebar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgb(120, 120, 148);
        margin-bottom: 12px;
        flex-shrink: 0;
    }
    .blogHero__sidebar-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, #818cf8, #a855f7);
        animation: dotPulse 2.5s ease-in-out infinite;
    }
    .blogHero__sidebar-list {
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        height: 100%;
    }
    .blogHero__sidebar-list :global(.blogCardPopular:nth-child(1)) { animation-delay: 0.4s; }
    .blogHero__sidebar-list :global(.blogCardPopular:nth-child(2)) { animation-delay: 0.52s; }
    .blogHero__sidebar-list :global(.blogCardPopular:nth-child(3)) { animation-delay: 0.64s; }

    /* ── Keyframes ── */
    @keyframes fadeSlideDown {
        from { opacity: 0; transform: translateY(-18px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeSlideRight {
        from { opacity: 0; transform: translateX(28px); }
        to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes dotPulse {
        0%, 100% { box-shadow: 0 0 5px rgba(129,140,248,0.4); }
        50%       { box-shadow: 0 0 16px rgba(129,140,248,1), 0 0 30px rgba(168,85,247,0.55); }
    }
    @media screen and min-with {
        
    }
</style>