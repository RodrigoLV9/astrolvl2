---
import MainLogo from './MainLogo.astro';
import {LanguageButton} from './LanguageButton.tsx';
import {SelectServices} from './SelectServices.tsx'
---

<header class="header">
    <MainLogo/>
    <nav class="header-nav">
        <ul class="header-nav__list">
            <li><a href="/home">Home</a></li>
            <SelectServices/>
            <li><a href="/process">Process</a></li>
            <li><a href="/blogs">Blogs</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </nav>
    <LanguageButton client:load />
</header>
<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: fixed;
        z-index: 5;
        width: 100%;
        top: 0;
        height: 64px;
        padding: 0 2rem;
        background-color: rgba(5, 3, 10, 0.72);
        color: white;
        border-bottom: 1px solid rgba(32, 178, 170, 0.12);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
    }

    .header-nav__list {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
    }

    .header-nav__list li {
        padding: 0;
    }

    .header-nav__list li a {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.78);
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.5rem 0.875rem;
        border-radius: 6px;
        transition: color 0.2s ease, background-color 0.2s ease;
        display: block;
    }

    .header-nav__list li a:hover {
        color: lightseagreen;
        background-color: rgba(32, 178, 170, 0.08);
    }

    @media screen and (max-width: 768px) {
        .header {
            padding: 0 1rem;
        }

        .header-nav__list {
            gap: 0;
        }

        .header-nav__list li a {
            padding: 0.5rem 0.5rem;
            font-size: 0.8rem;
        }
    }
</style>