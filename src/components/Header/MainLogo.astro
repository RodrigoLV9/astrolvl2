---
import type { Locale } from '../../i18n';
import { localizedPage } from '../../lib/routes';

interface Props {
    locale: Locale;
    brandName: string;
}

const { locale, brandName } = Astro.props;
---
<a href={localizedPage(locale, 'home')} class="mainLogo">
    <img src="/comets.png" alt="comets" width="30" height="30">
    <h3>{brandName}</h3>
</a>
<style>
    .mainLogo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }
    .mainLogo:hover {
        opacity: 0.8;
    }
    .mainLogo h3 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(135deg, var(--clr-blue) 0%, var(--clr-purple) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>