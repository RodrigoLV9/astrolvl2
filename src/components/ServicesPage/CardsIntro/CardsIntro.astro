---
import {Card} from './Card.tsx'
import {
  BsRocketTakeoffFill,
  BsGraphUpArrow,
} from 'react-icons/bs'
import {
  HiOutlineDevicePhoneMobile,
} from 'react-icons/hi2'
import {
  MdOutlineStorefront,
  MdOutlinePayment,
  MdOutlineInventory2,
} from 'react-icons/md'
import {
  RiSpeedUpLine,
  RiUserSettingsLine,
  RiSearchEyeLine,
} from 'react-icons/ri'
import {
  TbClockHour4,
  TbReportAnalytics,
  TbCloudLock,
} from 'react-icons/tb'
import { getDictionary, getLocaleFromPath, isServiceSlug, type ServiceSlug } from '../../../i18n'

interface Props {
  service: string
}
const { service } = Astro.props
const locale = getLocaleFromPath(Astro.url.pathname)
const dict = getDictionary(locale)
const serviceKey: ServiceSlug = isServiceSlug(service) ? service : 'landing-page'

const visuals: Record<ServiceSlug, Array<{ Icon: any; color: string }>> = {
  'landing-page': [
    { Icon: BsRocketTakeoffFill, color: '#6366f1' },
    { Icon: BsGraphUpArrow, color: '#22d3ee' },
    { Icon: HiOutlineDevicePhoneMobile, color: '#a78bfa' },
  ],
  'website': [
    { Icon: RiUserSettingsLine, color: '#6366f1' },
    { Icon: RiSearchEyeLine, color: '#22d3ee' },
    { Icon: RiSpeedUpLine, color: '#a78bfa' },
  ],
  'ecommerce': [
    { Icon: MdOutlinePayment, color: '#6366f1' },
    { Icon: MdOutlineStorefront, color: '#22d3ee' },
    { Icon: MdOutlineInventory2, color: '#a78bfa' },
  ],
  'support': [
    { Icon: TbClockHour4, color: '#6366f1' },
    { Icon: TbCloudLock, color: '#22d3ee' },
    { Icon: TbReportAnalytics, color: '#a78bfa' },
  ],
}

const cardTexts = dict.servicesPage.cardsIntro[serviceKey]
const cards = cardTexts.cards.map((card, index) => {
  const visual = visuals[serviceKey][index]
  return {
    ...card,
    Icon: visual?.Icon ?? BsRocketTakeoffFill,
    color: visual?.color ?? '#6366f1',
  }
})
---
<section class="cardsIntro-section section-shell">
  <div class="cardsIntro-header section-header">
    <span class="cardsIntro-eyebrow section-eyebrow">{cardTexts.eyebrow}</span>
    <h2 class="cardsIntro-heading section-heading">{cardTexts.heading}</h2>
    <p class="cardsIntro-subtitle section-subtitle">{cardTexts.subtitle}</p>
  </div>
  <div class="cardsIntro-grid">
    {cards.map(c => <Card Icon={c.Icon} title={c.title} description={c.description} accentColor={c.color}/>)}
  </div>
</section>
<style>
  .cardsIntro-section {
    padding: 80px 0 100px;
  }
  .cardsIntro-header {
    max-width: 640px;
    margin: 0 auto 56px;
  }
  .cardsIntro-heading {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  }
  .cardsIntro-subtitle {
    font-size: 0.93rem;
    color: rgba(180,185,210,0.75);
  }
  .cardsIntro-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 1100px) {
    .cardsIntro-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
  }
  @media (max-width: 900px) {
    .cardsIntro-section {
      padding: 70px 0 86px;
    }
    .cardsIntro-header {
      margin-bottom: 40px;
    }
    .cardsIntro-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cardsIntro-section {
      padding: 60px 0 74px;
    }
    .cardsIntro-heading {
      font-size: clamp(1.35rem, 7.5vw, 1.8rem);
    }
    .cardsIntro-subtitle {
      font-size: var(--text-sm);
      line-height: 1.55;
    }
  }
</style>