---
import { getDictionary, getLocaleFromPath, isServiceSlug, type ServiceSlug } from '../../i18n'

interface Props {
  service: string
}
const { service } = Astro.props
const locale = getLocaleFromPath(Astro.url.pathname)
const dict = getDictionary(locale)
const serviceKey: ServiceSlug = isServiceSlug(service) ? service : 'landing-page'

const imageByService: Record<ServiceSlug, string> = {
  'landing-page': 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&q=80',
  website: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=800&q=80',
  ecommerce: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80',
  support: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&q=80',
}

const d = dict.servicesPage.intro[serviceKey]
---

<section class="intro section-shell--compact">
  <div class="intro__img-wrap">
    <img src={imageByService[serviceKey]} alt={d.imageAlt} loading="lazy"/>
    <div class="intro__img-aura"></div>
    <div class="intro__float-badge">
      <strong class="intro__float-badge-value">{d.badge.value}</strong>
      <div class="intro__float-badge-text">
        <span class="intro__float-badge-label">{d.badge.label}</span>
        <span class="intro__float-badge-sub">{d.badge.sub}</span>
      </div>
    </div>
  </div>

  <div class="intro__content">
    <span class="intro__eyebrow">{d.eyebrow}</span>
    <h2 class="intro__heading">{d.heading}</h2>
    <p class="intro__body">{d.body}</p>

    <ul class="intro__bullets">
      {d.bullets.map(b => (
        <li class="intro__bullet">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          {b}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: 72px;
    padding: 80px 0 100px;
  }

  /* ── Image ── */
  .intro__img-wrap {
    position: relative;
    flex-shrink: 0;
    width: 440px;
  }
  .intro__img-wrap img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: 24px;
    display: block;
    position: relative;
    z-index: 1;
    border: 1px solid rgba(255,255,255,0.09);
  }
  .intro__img-aura {
    position: absolute;
    inset: -28px;
    border-radius: 36px;
    background: radial-gradient(ellipse at 40% 60%, rgba(99,102,241,0.2) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  /* Floating badge */
  .intro__float-badge {
    position: absolute;
    bottom: 20px;
    left: -20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(10,10,20,0.85);
    border: 1px solid rgba(99,102,241,0.35);
    border-radius: 14px;
    padding: 14px 18px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .intro__float-badge-value {
    font-size: 1.6rem;
    font-weight: 900;
    background: linear-gradient(135deg, #818cf8, #38bdf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    white-space: nowrap;
    line-height: 1;
  }
  .intro__float-badge-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .intro__float-badge-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #e2e8f0;
    line-height: 1;
  }
  .intro__float-badge-sub {
    font-size: 0.72rem;
    color: rgba(180,185,210,0.6);
    line-height: 1;
  }

  /* ── Content ── */
  .intro__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clr-primary-dull);
  }
  .intro__heading {
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.22;
    color: var(--txt-light);
    margin: 0;
  }
  .intro__body {
    font-size: 0.93rem;
    line-height: 1.78;
    color: rgba(180,185,210,0.82);
    margin: 0;
  }

  /* ── Bullets ── */
  .intro__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .intro__bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: rgba(200,210,235,0.88);
    line-height: 1.55;
  }
  .intro__bullet svg {
    color: #22d3ee;
    flex-shrink: 0;
    margin-top: 2px;
  }
  @media (max-width: 1100px) {
    .intro {
      gap: 46px;
    }
    .intro__img-wrap {
      width: 390px;
    }
  }
  @media (max-width: 860px) {
    .intro {
      flex-direction: column;
      gap: 48px;
      padding: 60px 0;
    }
    .intro__img-wrap {
      width: 100%;
    }
    .intro__img-wrap img {
      height: 320px;
    }
    .intro__float-badge {
      left: 12px;
      bottom: 12px;
    }
  }
  @media (max-width: 520px) {
    .intro {
      gap: 30px;
      padding: 52px 0 62px;
    }
    .intro__img-wrap img {
      height: 240px;
      border-radius: var(--rad-lg);
    }
    .intro__img-aura {
      inset: -14px;
      border-radius: 24px;
    }
    .intro__float-badge {
      left: 8px;
      bottom: 8px;
      padding: 10px 12px;
      gap: 8px;
      border-radius: var(--rad-md);
    }
    .intro__float-badge-value {
      font-size: 1.2rem;
    }
    .intro__float-badge-label {
      font-size: 0.72rem;
    }
    .intro__float-badge-sub {
      font-size: 0.66rem;
    }
    .intro__content {
      gap: 14px;
    }
    .intro__heading {
      font-size: clamp(1.35rem, 7vw, 1.75rem);
    }
    .intro__body {
      font-size: var(--text-sm);
      line-height: 1.65;
    }
    .intro__bullet {
      font-size: var(--text-sm);
      line-height: 1.5;
    }
  }
</style>