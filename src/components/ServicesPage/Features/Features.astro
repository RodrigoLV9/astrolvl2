---
import { FeatureCard } from "./FeatureCard.tsx";
import { getDictionary, getLocaleFromPath, isServiceSlug, type ServiceSlug } from '../../../i18n'

interface Props {
  service: string
}
const { service } = Astro.props
const locale = getLocaleFromPath(Astro.url.pathname)
const dict = getDictionary(locale)
const serviceKey: ServiceSlug = isServiceSlug(service) ? service : 'landing-page'
const d = dict.servicesPage.features[serviceKey]
---

<section class="features section-shell">
  <div class="features__header section-header">
    <h2 class="features__heading section-heading">{d.heading}</h2>
    <p class="features__subtitle section-subtitle">{d.subtitle}</p>
  </div>
  <div class="features__grid">
    {d.features.map((f, i) => <FeatureCard label={f} index={i + 1}/>)}
  </div>
</section>

<style>
  .features {
    padding: 80px 0 100px;
  }
  .features__header {
    margin-bottom: 56px;
  }
  .features__heading {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  }
  .features__subtitle {
    font-size: 0.93rem;
    color: rgba(180,185,210,0.75);
    max-width: 540px;
    line-height: 1.6;
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 40px;
  }
  @media (max-width: 900px) {
    .features {
      padding: 72px 0 88px;
    }
    .features__header {
      margin-bottom: 42px;
    }
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px 18px;
    }
  }
  @media (max-width: 500px) {
    .features {
      padding: 60px 0 74px;
    }
    .features__heading {
      font-size: clamp(1.35rem, 7vw, 1.75rem);
    }
    .features__subtitle {
      font-size: var(--text-sm);
      line-height: 1.55;
    }
    .features__grid {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
