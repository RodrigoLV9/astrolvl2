---
import { DescriptionCard } from "./DescriptionCard.tsx";
import { servicesDescriptionData } from "../../../data/generalData.js";

interface Props {
  service: string
}
const { service } = Astro.props

const serviceKey = (service in servicesDescriptionData ? service : 'landing-page') as keyof typeof servicesDescriptionData
const d = servicesDescriptionData[serviceKey]
---

<section class="description section-shell">
  <div class="description__header section-header">
    <span class="description__eyebrow section-eyebrow">{d.eyebrow}</span>
    <h2 class="description__heading section-heading">{d.heading}</h2>
    <p class="description__subtitle section-subtitle">{d.subtitle}</p>
  </div>

  {d.sections.map((section, i) => (
    <div class={`description__row ${i % 2 === 1 ? 'description__row--reverse' : ''}`}>
      <div class="description__img-wrap">
        <img src={section.img} alt={section.imgAlt} loading="lazy"/>
      </div>
      <div class="description__cards">
        {section.cards.map(c => <DescriptionCard title={c.title} description={c.description}/>)}
      </div>
    </div>
  ))}
</section>

<style>
  .description {
    padding: 80px 0 60px;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  .description__header {
    max-width: 680px;
    margin: 0 auto;
  }
  .description__heading {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.2;
  }
  .description__subtitle {
    font-size: 0.95rem;
    color: rgba(180,185,210,0.75);
    line-height: 1.6;
  }
  /* Divider between rows */
  .description__row + .description__row {
    padding-top: 60px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  /* Row */
  .description__row {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .description__row--reverse {
    flex-direction: row-reverse;
  }
  /* Image */
  .description__img-wrap {
    flex-shrink: 0;
    width: 420px;
    position: relative;
  }
  .description__img-wrap::after {
    content: '';
    position: absolute;
    inset: -16px;
    border-radius: 28px;
    background: radial-gradient(ellipse at center, rgba(99,102,241,0.13) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .description__img-wrap img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.09);
    display: block;
    position: relative;
    z-index: 1;
  }
  /* Cards grid */
  .description__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    flex: 1;
  }
  @media (max-width: 1200px) {
    .description__row {
      gap: 40px;
    }
    .description__img-wrap {
      width: 380px;
    }
  }
  @media (max-width: 960px) {
    .description {
      gap: 46px;
      padding: 70px 0 54px;
    }
    .description__row + .description__row {
      padding-top: 46px;
    }
    .description__row,
    .description__row--reverse {
      flex-direction: column;
      gap: 36px;
    }
    .description__img-wrap {
      width: 100%;
    }
    .description__img-wrap img {
      height: 320px;
    }
  }
  @media (max-width: 600px) {
    .description {
      padding: 60px 0 46px;
      gap: 36px;
    }
    .description__header {
      max-width: 100%;
    }
    .description__heading {
      font-size: clamp(1.4rem, 7vw, 1.9rem);
    }
    .description__subtitle {
      font-size: var(--text-sm);
      line-height: 1.55;
    }
    .description__img-wrap::after {
      inset: -10px;
      border-radius: 20px;
    }
    .description__img-wrap img {
      height: 250px;
    }
    .description__row,
    .description__row--reverse {
      gap: 22px;
    }
    .description__cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
