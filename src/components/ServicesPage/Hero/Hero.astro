---
import { HeroTag } from "./HeroTag";
import { CarouselHero } from '../../CarouselHero'
import LandingPageIllustration from './illustrations/LandingPageIllustration.astro'
import WebsiteIllustration from './illustrations/WebsiteIllustration.astro'
import EcommerceIllustration from './illustrations/EcommerceIllustration.astro'
import SupportIllustration from './illustrations/SupportIllustration.astro'
import { getDictionary, getLocaleFromPath, isServiceSlug } from '../../../i18n'
import { localizedPage } from '../../../lib/routes'

interface Props {
  service: string
}

const { service } = Astro.props

const locale = getLocaleFromPath(Astro.url.pathname)
const dict = getDictionary(locale)

const serviceKey = isServiceSlug(service) ? service : 'landing-page'
const data = dict.servicesPage.hero[serviceKey]
---
<section class="hero">
    <div class="heroLeft">
        <div class="hero__badge">
            <span class="hero__badge-dot"></span>
            <span>{data.badge}</span>
        </div>
        <div class="heroLeft__text">
            <h1>{data.title}</h1>
            <p class="hero__description">{data.description}</p>
        </div>
        <div class="heroLeft__tags">
            {data.tags.map(tag => <HeroTag label={tag}/>)}
        </div>
        <div class="hero__cta-group">
            <a href={localizedPage(locale, 'contact')} class="hero__btn-primary">
                {data.primaryCTA}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href={localizedPage(locale, 'process')} class="hero__btn-secondary">{data.secondaryCTA}</a>
        </div>
    </div>
    <div class="heroRight">
        {service === 'landing-page' && <LandingPageIllustration/>}
        {service === 'website' && <WebsiteIllustration/>}
        {service === 'ecommerce' && <EcommerceIllustration/>}
        {service === 'support' && <SupportIllustration/>}
    </div>
    <CarouselHero/>
</section>
<style>
    .hero {
        position: relative;
        min-height: 100dvh;
        width: min(92%, var(--max-w));
        margin: 0 auto;
        padding: 110px 0 170px;
        display: flex;
        align-items: center;
        justify-content: space-evenly;
        gap: 40px;
    }

    /* ── Left column ── */
    .heroLeft {
        max-width: 580px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    /* ── Badge ── */
    .hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 5px 14px;
        border-radius: 100px;
        border: 1px solid rgba(99, 102, 241, 0.35);
        background: rgba(99, 102, 241, 0.08);
        font-size: 0.78rem;
        font-weight: 500;
        color: #a5b4fc;
        letter-spacing: 0.3px;
    }
    .hero__badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        flex-shrink: 0;
        animation: heroBadgePulse 2.2s ease-in-out infinite;
    }
    @keyframes heroBadgePulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    /* ── Heading ── */
    .heroLeft__text h1 {
        font-size: clamp(2.1rem, 3vw, 3.4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -1.5px;
        color: #ffffff;
        margin: 0;
    }
    .hero__description {
        margin: 12px 0 0;
        font-size: 1.05rem;
        font-weight: 400;
        line-height: 1.7;
        color: rgba(196, 200, 235, 0.78);
        max-width: 520px;
    }

    /* ── Tags ── */
    .heroLeft__tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ── CTA group ── */
    .hero__cta-group {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .hero__btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 24px;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #6366f1, #3b82f6);
        text-decoration: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        letter-spacing: 0.1px;
        white-space: nowrap;
    }
    .hero__btn-primary:hover {
        opacity: 0.88;
        transform: translateY(-2px);
    }
    .hero__btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 13px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 500;
        color: rgba(200, 205, 240, 0.8);
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
        transition: background 0.2s ease, border-color 0.2s ease;
        white-space: nowrap;
    }
    .hero__btn-secondary:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.22);
    }

    /* ── Right column (illustration) ── */
    .heroRight {
        flex: 1;
        max-width: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .heroRight :global(svg.service-illustration) {
        width: 100%;
        height: auto;
    }

    @media (max-width: 1100px) {
        .hero {
            gap: 26px;
            padding-top: 100px;
        }
        .heroRight {
            max-width: 420px;
        }
    }

    @media (max-width: 900px) {
        .hero {
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            gap: 34px;
            min-height: auto;
            padding: 96px 0 160px;
        }
        .heroLeft {
            max-width: 100%;
        }
        .heroRight {
            width: min(480px, 100%);
            max-width: 480px;
            align-self: center;
        }
    }

    @media (max-width: 640px) {
        .hero {
            width: min(94%, var(--max-w));
            padding: 88px 0 132px;
            gap: 28px;
        }
        .heroLeft {
            gap: 20px;
        }
        .heroLeft__text h1 {
            font-size: clamp(1.85rem, 9vw, 2.45rem);
            letter-spacing: -1px;
        }
        .hero__description {
            font-size: var(--text-base);
            line-height: 1.65;
            margin-top: 10px;
        }
        .hero__cta-group {
            width: 100%;
            gap: 10px;
        }
        .hero__btn-primary,
        .hero__btn-secondary {
            width: 100%;
            justify-content: center;
            padding: 12px 16px;
            font-size: var(--text-sm);
        }
        .hero__badge {
            font-size: var(--text-xs);
        }
    }
</style>