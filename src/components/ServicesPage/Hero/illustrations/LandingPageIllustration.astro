---
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 340" fill="none" class="service-illustration">
  <defs>
    <radialGradient id="bg-lp" cx="35%" cy="50%" r="60%" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#4169e1" stop-opacity="0.28"/>
      <stop offset="100%" stop-color="#4169e1" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="hero-lp" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1a1870"/>
      <stop offset="100%" stop-color="#0a0920"/>
    </linearGradient>
    <linearGradient id="cta-lp" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#5575f0"/>
      <stop offset="100%" stop-color="#3a55d0"/>
    </linearGradient>
    <linearGradient id="bar-lp" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4169e1" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#4169e1" stop-opacity="0.3"/>
    </linearGradient>
    <filter id="glow-lp" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- Ambient glow -->
  <ellipse cx="250" cy="170" rx="220" ry="165" fill="url(#bg-lp)"/>

  <g transform="translate(87,0)">
  <!-- ===== BROWSER SHADOW ===== -->
  <rect x="14" y="24" width="306" height="252" rx="14" fill="#4169e1" opacity="0.12"/>

  <!-- ===== BROWSER WINDOW ===== -->
  <rect x="10" y="20" width="306" height="250" rx="12" fill="#08071e" stroke="#2a2870" stroke-width="1.5"/>

  <!-- Toolbar -->
  <rect x="10" y="20" width="306" height="36" rx="12" fill="#0e0c32"/>
  <rect x="10" y="44" width="306" height="12" fill="#0e0c32"/>

  <!-- Traffic lights -->
  <circle cx="28" cy="38" r="4.5" fill="#ff5f57"/>
  <circle cx="44" cy="38" r="4.5" fill="#febc2e"/>
  <circle cx="60" cy="38" r="4.5" fill="#28c840"/>

  <!-- URL bar -->
  <rect x="78" y="26" width="192" height="20" rx="10" fill="#16144a"/>
  <circle cx="94" cy="36" r="4" fill="#2a2870"/>
  <rect x="102" y="32" width="120" height="8" rx="3" fill="#1e1c58"/>

  <!-- ===== FULL-BLEED HERO ===== -->
  <rect x="10" y="56" width="306" height="96" fill="url(#hero-lp)"/>

  <!-- Hero large headline block -->
  <rect x="22" y="68" width="170" height="14" rx="5" fill="#3a52c0" opacity="0.9"/>
  <rect x="22" y="89" width="135" height="9" rx="3" fill="#242268" opacity="0.75"/>
  <rect x="22" y="104" width="155" height="9" rx="3" fill="#242268" opacity="0.55"/>

  <!-- Primary CTA button -->
  <rect x="22" y="120" width="90" height="22" rx="11" fill="url(#cta-lp)" filter="url(#glow-lp)"/>
  <rect x="30" y="126" width="74" height="10" rx="3" fill="#7a9aff" opacity="0.5"/>

  <!-- Ghost CTA -->
  <rect x="120" y="120" width="68" height="22" rx="11" fill="none" stroke="#4169e1" stroke-width="1.3"/>
  <rect x="130" y="126" width="48" height="10" rx="3" fill="#2a3280" opacity="0.6"/>

  <!-- Hero visual element (abstract rising arrow) -->
  <path d="M250 140 L265 110 L280 130 L295 95 L310 115" stroke="#4169e1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.7"/>
  <circle cx="295" cy="95" r="5" fill="#4169e1" opacity="0.9" filter="url(#glow-lp)"/>
  <!-- Sparkle dots -->
  <circle cx="255" cy="108" r="2.5" fill="#6a89ff" opacity="0.8"/>
  <circle cx="275" cy="128" r="2" fill="#6a89ff" opacity="0.6"/>

  <!-- ===== SOCIAL PROOF BAR ===== -->
  <rect x="10" y="152" width="306" height="24" fill="#060518"/>
  <!-- Avatars row -->
  <circle cx="24" cy="164" r="8" fill="#1e1c4e"/>
  <circle cx="24" cy="164" r="8" fill="none" stroke="#4169e1" stroke-width="1"/>
  <circle cx="37" cy="164" r="8" fill="#241e56"/>
  <circle cx="37" cy="164" r="8" fill="none" stroke="#4169e1" stroke-width="1"/>
  <circle cx="50" cy="164" r="8" fill="#2a2460"/>
  <circle cx="50" cy="164" r="8" fill="none" stroke="#4169e1" stroke-width="1"/>
  <circle cx="63" cy="164" r="8" fill="#302a6a"/>
  <circle cx="63" cy="164" r="8" fill="none" stroke="#4169e1" stroke-width="1"/>
  <!-- Stars rating -->
  <rect x="80" y="159" width="60" height="10" rx="3" fill="#12114a"/>
  <path d="M83 165 l1.5-4 1.5 4h4l-3.3 2.4 1.3 4-3.5-2.5-3.5 2.5 1.3-4L78 165z" fill="#FFD700" opacity="0.9"/>
  <path d="M96 165 l1.5-4 1.5 4h4l-3.3 2.4 1.3 4-3.5-2.5-3.5 2.5 1.3-4L91 165z" fill="#FFD700" opacity="0.9"/>
  <path d="M109 165 l1.5-4 1.5 4h4l-3.3 2.4 1.3 4-3.5-2.5-3.5 2.5 1.3-4L104 165z" fill="#FFD700" opacity="0.9"/>

  <!-- ===== FEATURES SECTION ===== -->
  <rect x="10" y="176" width="306" height="94" fill="#060514"/>

  <!-- Section heading bar -->
  <rect x="22" y="184" width="90" height="8" rx="3" fill="#1a1850"/>
  <rect x="118" y="188" width="180" height="1" fill="#1a1840" opacity="0.5"/>

  <!-- Feature card 1 -->
  <rect x="18" y="198" width="88" height="64" rx="8" fill="#0c0b2a" stroke="#2a2868" stroke-width="1.2"/>
  <!-- Icon circle -->
  <circle cx="42" cy="218" r="12" fill="#1a1860"/>
  <circle cx="42" cy="218" r="9" fill="#242490" opacity="0.6"/>
  <!-- Arrow up icon abstraction -->
  <path d="M38 221 L42 213 L46 221" stroke="#4169e1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <line x1="42" y1="213" x2="42" y2="224" stroke="#4169e1" stroke-width="2" stroke-linecap="round"/>
  <!-- Text bars under icon -->
  <rect x="24" y="235" width="76" height="6" rx="2" fill="#1e1c58"/>
  <rect x="28" y="247" width="60" height="4" rx="2" fill="#141440" opacity="0.7"/>
  <rect x="28" y="254" width="50" height="4" rx="2" fill="#141440" opacity="0.5"/>

  <!-- Feature card 2 -->
  <rect x="116" y="198" width="88" height="64" rx="8" fill="#0c0b2a" stroke="#2a2868" stroke-width="1.2"/>
  <circle cx="140" cy="218" r="12" fill="#1a1860"/>
  <circle cx="140" cy="218" r="9" fill="#242490" opacity="0.6"/>
  <!-- Target icon abstraction -->
  <circle cx="140" cy="218" r="6" stroke="#4169e1" stroke-width="1.5" fill="none"/>
  <circle cx="140" cy="218" r="3" fill="#4169e1" opacity="0.7"/>
  <rect x="122" y="235" width="76" height="6" rx="2" fill="#1e1c58"/>
  <rect x="126" y="247" width="60" height="4" rx="2" fill="#141440" opacity="0.7"/>
  <rect x="126" y="254" width="50" height="4" rx="2" fill="#141440" opacity="0.5"/>

  <!-- Feature card 3 -->
  <rect x="214" y="198" width="88" height="64" rx="8" fill="#0c0b2a" stroke="#2a2868" stroke-width="1.2"/>
  <circle cx="238" cy="218" r="12" fill="#1a1860"/>
  <circle cx="238" cy="218" r="9" fill="#242490" opacity="0.6"/>
  <!-- Lightning bolt icon abstraction -->
  <path d="M240 210 L235 219 L239 219 L237 226 L242 217 L238 217 Z" fill="#4169e1" opacity="0.9"/>
  <rect x="220" y="235" width="76" height="6" rx="2" fill="#1e1c58"/>
  <rect x="224" y="247" width="60" height="4" rx="2" fill="#141440" opacity="0.7"/>
  <rect x="224" y="254" width="50" height="4" rx="2" fill="#141440" opacity="0.5"/>
  </g>

</svg>
