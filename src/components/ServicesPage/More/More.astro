---
import { MoreCard } from "./MoreCard";
import { getDictionary, getLocaleFromPath, isServiceSlug, type ServiceSlug } from '../../../i18n';
import { localizedService } from '../../../lib/routes';

interface Props {
  service: string
}
const { service } = Astro.props
const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const serviceKey: ServiceSlug = isServiceSlug(service) ? service : 'landing-page';

const texts = dict.servicesPage.more;
const others = texts.cards.filter((s) => s.slug !== serviceKey);
---

<section class="more section-shell--compact">
  <div class="more__divider"></div>
  <div class="more__header section-header">
    <span class="more__eyebrow section-eyebrow">{texts.eyebrow}</span>
    <h2 class="more__heading section-heading">{texts.headingStart} <span class="more__heading-accent">{texts.headingHighlight}</span>{texts.headingEnd}</h2>
    <p class="more__subtitle section-subtitle">{texts.subtitle}</p>
  </div>
  <div class="more__grid">
    {others.map(s => (
      <MoreCard
        slug={s.slug}
        tag={s.tag}
        title={s.title}
        description={s.description}
        href={localizedService(locale, s.slug)}
        ctaLabel={texts.cardCta}
        client:load
      />
    ))}
  </div>
</section>

<style>
  .more {
    padding: 80px 0 100px;
  }
  .more__divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99,102,241,0.35) 30%, rgba(139,92,246,0.35) 70%, transparent);
    margin-bottom: 80px;
  }
  .more__header {
    gap: 14px;
    margin-bottom: 56px;
  }
  .more__eyebrow {
    padding: 5px 14px;
    background: rgba(99,102,241,0.08);
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: 100px;
    width: fit-content;
  }
  .more__heading {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.2;
  }
  .more__heading-accent {
    background: linear-gradient(135deg, #818cf8, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .more__subtitle {
    font-size: 0.95rem;
    color: rgba(180,185,210,0.7);
    max-width: 500px;
    line-height: 1.7;
  }
  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 900px) {
    .more {
      padding: 70px 0 90px;
    }
    .more__divider {
      margin-bottom: 58px;
    }
    .more__header {
      margin-bottom: 40px;
    }
    .more__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 580px) {
    .more__grid {
      grid-template-columns: 1fr;
    }
    .more {
      padding: 60px 0 80px;
    }
    .more__divider {
      margin-bottom: 40px;
    }
    .more__heading {
      font-size: clamp(1.4rem, 7vw, 1.8rem);
    }
    .more__subtitle {
      font-size: var(--text-sm);
      line-height: 1.55;
    }
    .more__eyebrow {
      padding: 4px 10px;
    }
  }
</style>
