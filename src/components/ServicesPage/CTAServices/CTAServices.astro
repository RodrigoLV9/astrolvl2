---
import { CTAServicesButton } from "./CTAServicesButton.tsx";

interface Props {
  service: string
}
const { service } = Astro.props

const data: Record<string, {
  eyebrow: string
  heading: string
  subtitle: string
  price: string
  priceNote: string
  includes: string[]
}> = {
  'landing-page': {
    eyebrow: 'Inversión',
    heading: 'Landing page profesional desde $1,200',
    subtitle: 'Precio fijo, alcance definido, sin sorpresas. Paga en dos cuotas: 50% al inicio del proyecto y 50% en la entrega.',
    price: '$1,200',
    priceNote: 'Precio base — varía según integraciones y funcionalidades adicionales',
    includes: [
      'Diseño UI/UX de alta fidelidad',
      'Copywriting incluido',
      'Integraciones de marketing configuradas',
      'Soporte 30 días post-lanzamiento',
    ],
  },
  'website': {
    eyebrow: 'Inversión',
    heading: 'Sitio web corporativo desde $2,500',
    subtitle: 'Precio fijo, alcance definido desde el Discovery. Sin cargos por hora ni revisiones ilimitables cobradas aparte.',
    price: '$2,500',
    priceNote: 'Precio base — varía según número de páginas, CMS y funcionalidades',
    includes: [
      'Diseño UI/UX personalizado',
      'CMS integrado para tu equipo',
      'SEO técnico completo',
      'Soporte 30 días post-lanzamiento',
    ],
  },
  'ecommerce': {
    eyebrow: 'Inversión',
    heading: 'Tienda online lista para vender desde $3,500',
    subtitle: 'Incluye diseño, desarrollo, integraciones de pago y carga inicial del catálogo. Un solo proveedor para todo.',
    price: '$3,500',
    priceNote: 'Precio base — varía según pasarelas, integraciones logísticas y tamaño del catálogo',
    includes: [
      'Diseño UI/UX del flujo completo',
      'Pasarelas de pago configuradas',
      'SEO por producto incluido',
      'Soporte 30 días post-lanzamiento',
    ],
  },
  'support': {
    eyebrow: 'Inversión',
    heading: 'Mantenimiento mensual desde $299/mes',
    subtitle: 'Pago mensual recurrente, sin contrato anual obligatorio. Puedes escalar o pausar el plan con 15 días de aviso.',
    price: '$299/mes',
    priceNote: 'Precio base plan Esencial — planes Profesional y Premium disponibles',
    includes: [
      'Monitoreo 24/7 incluido',
      'Backups diarios automáticos',
      'Actualizaciones de seguridad',
      'Reporte mensual detallado',
    ],
  },
}

const d = data[service] ?? data['landing-page']
---

<section class="cta-services">
  <div class="cta-services__inner">
    <div class="cta-services__content">
      <span class="cta-services__eyebrow">{d.eyebrow}</span>
      <h2 class="cta-services__heading">{d.heading}</h2>
      <p class="cta-services__subtitle">{d.subtitle}</p>
      <ul class="cta-services__includes">
        {d.includes.map(item => (
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {item}
          </li>
        ))}
      </ul>
      <CTAServicesButton service={service} client:load/>
      <span class="cta-services__note">{d.priceNote}</span>
    </div>
    <div class="cta-services__price-badge">
      <span class="cta-services__price-label">desde</span>
      <strong class="cta-services__price">{d.price}</strong>
    </div>
  </div>
</section>

<style>
  .cta-services {
    padding: 80px 0 100px;
    width: min(92%, 1100px);
    margin: 0 auto;
  }
  .cta-services__inner {
    background: linear-gradient(145deg, rgba(99,102,241,0.1) 0%, rgba(8,12,30,0.97) 45%, rgba(14,22,45,0.98) 100%);
    border: 1px solid rgba(99,102,241,0.35);
    border-radius: 28px;
    padding: 60px 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 0 80px rgba(99,102,241,0.1),
      0 32px 64px rgba(0,0,0,0.5);
  }
  .cta-services__inner::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -60px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99,102,241,0.22) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-services__inner::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: 20px;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56,189,248,0.1) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-services__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 580px;
    z-index: 1;
  }
  .cta-services__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #818cf8;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
  }
  .cta-services__eyebrow::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 2px;
    background: linear-gradient(90deg, #6366f1, #818cf8);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .cta-services__heading {
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 800;
    color: #e2e8f0;
    margin: 0;
    line-height: 1.25;
  }
  .cta-services__subtitle {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(180,185,210,0.75);
    margin: 0;
    max-width: 500px;
  }
  .cta-services__includes {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .cta-services__includes li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    color: rgba(200,205,230,0.85);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 8px 12px;
    transition: background 0.2s, border-color 0.2s;
  }
  .cta-services__includes li:hover {
    background: rgba(99,102,241,0.07);
    border-color: rgba(99,102,241,0.22);
  }
  .cta-services__includes li svg {
    background: rgba(34,211,238,0.12);
    color: #22d3ee;
    flex-shrink: 0;
    border-radius: 50%;
    padding: 3px;
    width: 20px;
    height: 20px;
    box-sizing: content-box;
  }
  .cta-services__note {
    font-size: 0.74rem;
    color: rgba(150,160,190,0.55);
    margin-top: 4px;
    line-height: 1.5;
  }
  /* Price badge */
  .cta-services__price-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    z-index: 1;
    background: linear-gradient(145deg, rgba(99,102,241,0.12), rgba(56,189,248,0.05));
    border: 1px solid rgba(99,102,241,0.35);
    border-radius: 20px;
    padding: 36px 44px;
    min-width: 200px;
    position: relative;
    backdrop-filter: blur(8px);
    box-shadow: 0 0 30px rgba(99,102,241,0.1), 0 4px 24px rgba(0,0,0,0.35);
  }
  .cta-services__price-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(129,140,248,0.7), transparent);
  }
  .cta-services__price-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(180,185,210,0.55);
    font-weight: 600;
  }
  .cta-services__price {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    background: linear-gradient(135deg, #818cf8 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    white-space: nowrap;
    line-height: 1.1;
  }
  @media (max-width: 860px) {
    .cta-services__inner {
      flex-direction: column;
      padding: 44px 28px;
      text-align: center;
    }
    .cta-services__includes {
      grid-template-columns: 1fr;
      text-align: left;
      max-width: 360px;
      margin: 0 auto;
    }
    .cta-services__price-badge {
      order: -1;
      padding: 24px 40px;
      width: 100%;
      max-width: 280px;
    }
    .cta-services__eyebrow::before {
      display: none;
    }
  }
</style>
