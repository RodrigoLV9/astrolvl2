---
import { ContactForm } from "./ContactForm.tsx";
import {ContactCard} from "./ContactCard.tsx"
import { ItemSocial } from "./ItemSocial.tsx";
import type { SocialPlatform } from "./ItemSocial.tsx";
import { contactSocialsData, mainSocialNetworks } from '../../data/socialNetworks.js';
import { getDictionary, getLocaleFromPath } from '../../i18n';

const socialsItems = contactSocialsData as Array<{ platform: SocialPlatform; href: string }>;
const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);

const cardByNetwork = {
    whatsapp: mainSocialNetworks.find((item) => item.name === 'Whatsapp'),
    email: mainSocialNetworks.find((item) => item.name === 'Mail'),
    instagram: mainSocialNetworks.find((item) => item.name === 'Instagram'),
};

const contactCards = [
    {
        platform: 'whatsapp' as const,
        entry: cardByNetwork.whatsapp,
        label: dict.contact.cards.whatsappLabel,
        buttonText: dict.contact.cards.whatsappButton,
    },
    {
        platform: 'email' as const,
        entry: cardByNetwork.email,
        label: dict.contact.cards.emailLabel,
        buttonText: dict.contact.cards.emailButton,
    },
    {
        platform: 'instagram' as const,
        entry: cardByNetwork.instagram,
        label: dict.contact.cards.instagramLabel,
        buttonText: dict.contact.cards.instagramButton,
    },
].filter((card) => !!card.entry);
---
<section class="contact">
    <div class="contact__text">
        <h1>{dict.contact.heroTitle}</h1>
        <p>{dict.contact.heroSubtitle}</p>
    </div>
    <div class="contact__main">
        <div class="contact__main-left">
            <h2>{dict.contact.formTitle}</h2>
            <ContactForm client:load dict={dict} />
        </div>
        <div class="contact__main-right">
            <div class="right-header">
                <h2>{dict.contact.rightTitle}</h2>
                <p class="right-header__desc">
                    {dict.contact.rightSubtitle}
                </p>
            </div>
            <div class="cards__social">
                {contactCards.map(({ platform, entry, label, buttonText }) => (
                    <ContactCard
                        platform={platform}
                        value={entry!.info}
                        href={entry!.link}
                        label={label}
                        buttonText={buttonText}
                        client:load
                    />
                ))}
            </div>
        </div>
    </div>
    <div class="socials">
        <div class="socials__label">{dict.contact.socialsLabel}</div>
        <div class="socials__items">
            {socialsItems.map(({ platform, href }) => (
                <ItemSocial platform={platform} href={href} client:load />
            ))}
        </div>
    </div>
</section>
<style>
    .contact {
        padding: var(--sp-24) var(--px);
    }

    .contact__text {
        text-align: center;
        margin-bottom: var(--sp-12);
    }
    .contact__text h1 {
        margin-bottom: var(--sp-5);
    }
    .contact__text p {
        color: var(--txt-muted);
    }

    .contact__main {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 70px;
        width: 100%;
        max-width: var(--max-w-sm);
        margin: 0 auto;
    }

    .contact__main-left {
        width: 100%;
        max-width: 500px;
    }

    .contact__main-left h2 {
        margin-bottom: var(--sp-8);
    }

    .contact__main-right {
        width: min(440px, 100%);
        flex-shrink: 0;
    }

    /* Right section header */
    .right-header {
        margin-bottom: var(--sp-6);
    }
    .right-header h2 {
        font-size: var(--text-xl);
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: var(--sp-2);
    }

    .right-header__desc {
        font-size: var(--text-sm);
        color: var(--txt-dim);
        line-height: 1.65;
        margin: 0;
    }

    .cards__social {
        display: flex;
        flex-direction: column;
        gap: var(--sp-4);
        width: 100%;
    }

    /* Socials section */
    .socials {
        margin: var(--sp-20) 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
    }

    .socials__label {
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--txt-ghost);
    }

    .socials__items {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--sp-3);
        flex-wrap: wrap;
    }

    @media (max-width: 1200px) {
        .contact__main {
            gap: var(--sp-12);
        }
    }

    @media (max-width: 1024px) {
        .contact__main {
            flex-direction: column;
            align-items: center;
            gap: var(--sp-16);
        }

        .contact__main-left,
        .contact__main-right {
            max-width: 680px;
            width: 100%;
        }

        .right-header {
            margin-bottom: var(--sp-5);
        }
    }

    @media (max-width: 768px) {
        .contact {
            padding-top: var(--sp-16);
            padding-bottom: var(--sp-14);
        }

        .contact__text {
            margin-bottom: var(--sp-10);
        }

        .contact__text h1 {
            margin-bottom: var(--sp-3);
        }

        .contact__main {
            gap: var(--sp-12);
        }

        .contact__main-left h2,
        .right-header h2 {
            font-size: var(--text-2xl);
        }

        .socials {
            margin: var(--sp-14) 0 0;
            gap: var(--sp-4);
        }
    }

    @media (max-width: 560px) {
        .contact {
            padding: var(--sp-14) var(--sp-4) var(--sp-12);
        }

        .contact__text p {
            font-size: var(--text-sm);
        }

        .contact__main-left h2,
        .right-header h2 {
            font-size: var(--text-xl);
            margin-bottom: var(--sp-3);
        }

        .right-header__desc {
            font-size: var(--text-base);
            line-height: 1.55;
        }

        .cards__social {
            gap: var(--sp-3);
        }

        .socials__items {
            gap: var(--sp-2);
        }
    }
</style>