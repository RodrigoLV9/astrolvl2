---
import { Faqs1Controller } from './Faqs1Controller'
import { getDictionary, getLocaleFromPath } from '../../../i18n'

interface FaqItem {
  question: string
  answer: string
}

interface Props {
  faqs?: FaqItem[]
  eyebrow?: string
  title?: string
  subtitle?: string
}

const locale = getLocaleFromPath(Astro.url.pathname)
const dict = getDictionary(locale)

const defaultFaqs: FaqItem[] = dict.home.faqs.items

const {
  faqs = defaultFaqs,
  eyebrow = dict.home.faqs.eyebrow,
  title = dict.home.faqs.title,
  subtitle = dict.home.faqs.subtitle,
} = Astro.props
---

<section class="faqs1">
  <div class="faqs1__inner">
    <div class="faqs1__header">
      <p class="faqs1__eyebrow">{eyebrow}</p>
      <h2 class="faqs1__title">{title}</h2>
      <p class="faqs1__subtitle">{subtitle}</p>
    </div>
    <Faqs1Controller faqs={faqs} client:visible />
  </div>
</section>

<style>
  .faqs1 {
    padding: 100px 20px;
  }

  .faqs1__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .faqs1__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .faqs1__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--clr-purple);
    margin: 0 0 18px;
  }

  .faqs1__title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.8px;
    color: var(--txt-primary);
    margin: 0 0 18px;
  }

  .faqs1__subtitle {
    font-size: var(--text-base);
    color: var(--txt-dim);
    line-height: 1.75;
    margin: 0 auto;
    max-width: 500px;
  }

  @media (max-width: 768px) {
    .faqs1 {
      padding: 70px 20px;
    }

    .faqs1__header {
      margin-bottom: 44px;
    }
  }

  @media (max-width: 480px) {
    .faqs1 {
      padding: 56px 16px;
    }

    .faqs1__header {
      margin-bottom: 32px;
    }

    .faqs1__eyebrow {
      letter-spacing: 2.5px;
    }

    .faqs1__title {
      font-size: var(--text-3xl);
    }

    .faqs1__subtitle {
      font-size: var(--text-sm);
    }
  }
</style>