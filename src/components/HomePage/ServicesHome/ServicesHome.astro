---
import ServiceCard from "./ServiceCard.astro"
import { getDictionary, getLocaleFromPath } from "../../../i18n";
import { localizedService } from "../../../lib/routes";

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---

<section class="servicesHome">
    <div class="servicesHome__text">
        <h2>{dict.servicesHome.title}</h2>
        <h3>{dict.servicesHome.subtitle}</h3>
    </div>
    <div class="servicesHome__cards">
        {dict.servicesHome.cards.map((service) => (
            <ServiceCard
                title={service.title}
                price={service.price}
                description={service.description}
                tags={service.tags}
                href={localizedService(locale, service.slug)}
                moreLabel={dict.servicesHome.cardMore}
            />
        ))}
    </div>
</section>
<style>
    .servicesHome{
        margin: var(--sp-14) 200px;
    }
    .servicesHome__text{
        text-align: center;
        margin: var(--sp-20) var(--sp-14);
    }
    .servicesHome__text h2{
        font-size: var(--text-3xl);
        margin: var(--sp-5) 0
    }
    .servicesHome__text h3{
        font-size: var(--text-lg);
        font-weight: normal;
        color: var(--txt-muted)
    }
    .servicesHome__cards{
        display: flex;
        align-items: stretch;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--sp-8)
    }

    @media (max-width: 1280px) {
        .servicesHome { margin: var(--sp-14) var(--sp-16); }
    }
    @media (max-width: 1024px) {
        .servicesHome { margin: var(--sp-12) var(--sp-8); }
        .servicesHome__text { margin: var(--sp-12) var(--sp-8); }
    }
    @media (max-width: 768px) {
        .servicesHome { margin: var(--sp-10) var(--sp-5); }
        .servicesHome__text { margin: var(--sp-8) var(--sp-4); }
        .servicesHome__text h2 { font-size: var(--text-2xl); }
        .servicesHome__text h3 { font-size: var(--text-base); }
        .servicesHome__cards { gap: var(--sp-5); }
    }
    @media (max-width: 480px) {
        .servicesHome { margin: var(--sp-8) var(--px); }
        .servicesHome__text { margin: var(--sp-5) 0; }
        .servicesHome__text h2 { font-size: var(--text-xl); }
    }
</style>