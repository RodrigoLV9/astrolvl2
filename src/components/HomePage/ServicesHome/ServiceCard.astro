---
import { CardTag } from "./CardTag";

type ServiceCardProps = {
  title: string;
  price: string;
  description: string;
  tags: string[];
  href: string;
};

const { title, price, description, tags, href } = Astro.props as ServiceCardProps;
---
<div class="servicesCard">
        <h4 class="servicesCard__title">{title}</h4>
        <h5 class="servicesCard__price">{price}</h5>
        <p>{description}</p>
        <div class="servicesCard__tags">
          {tags.map((tag) => (
            <CardTag text={tag} />
          ))}
        </div>
        <a href={href} class="servicesCard__more">Ver más</a>
</div>
<style>
  .servicesCard{
    padding:10px 20px;
    border:1px solid gray;
    border-radius: 10px;
    width: 300px;
    
  }
  .servicesCard__title{
    color:steelblue;
    margin:15px 0;
  }
  .servicesCard__price{
    color:gold;
    font-size: .95rem;
    text-align: center;
    margin:10px 0;
  }
  .servicesCard p{
    font-size: .9rem;
    color:gray;
    margin:20px 0
  }
  .servicesCard__tags{
    display: flex;
    flex-direction: column;
    align-items: start;
    gap:15px;
    margin:20px 0;
  }
  .servicesCard__more{
    color:rgb(0, 104, 189);
    text-decoration: none;
    transition: color .3s ease;
  }
  .servicesCard__more:hover{
    color:rgb(46, 161, 255);
    transition: color .3s ease;
  }
</style>