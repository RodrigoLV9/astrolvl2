---
import Layout from '../layouts/Layout.astro';
import {HeroProcess} from '../components/ProcessPage/HeroProcess';
import IntroProcess from '../components/ProcessPage/Intro/IntroProcess.astro';
import Steps from '../components/ProcessPage/Steps/Steps.astro';
import Faqs2 from '../components/ProcessPage/Faqs2/Faqs2.astro';
import { getDictionary, getLocaleFromPath } from '../i18n';
import { localizedPage } from '../lib/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const baseSite = Astro.site ?? new URL(Astro.url.origin);
const homePath = localizedPage(locale, 'home');
const processPath = localizedPage(locale, 'process');
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: dict.header.nav.home,
            item: new URL(homePath, baseSite).toString(),
        },
        {
            "@type": "ListItem",
            position: 2,
            name: dict.header.nav.process,
            item: new URL(processPath, baseSite).toString(),
        },
    ],
};
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: dict.processPage.faqs.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
        },
    })),
};
---


<Layout seo={{ title: dict.header.nav.process, description: dict.process.hero.subtitle }}>
        <Fragment slot="head">
                <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
        </Fragment>
    <HeroProcess client:load text={dict.process.hero} />
    <IntroProcess/>
    <Steps/>
    <Faqs2/>
</Layout>