---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ServicesPage/Hero/Hero.astro'
import CardsIntro from '../components/ServicesPage/CardsIntro/CardsIntro.astro';
import Intro from '../components/ServicesPage/Intro.astro';
import Description from '../components/ServicesPage/Description/Description.astro';
import Features from '../components/ServicesPage/Features/Features.astro';
import Process from '../components/ServicesPage/Process/Process.astro';
import Faqs1 from '../components/HomePage/Faqs1/Faqs1.astro'
import CTAServices from '../components/ServicesPage/CTAServices/CTAServices.astro';
import More from '../components/ServicesPage/More/More.astro';
import { serviceFaqsData, serviceFaqTitlesData, servicesStaticPathsData } from '../data/generalData.js';

interface FaqItem {
  question: string
  answer: string
}

export async function getStaticPaths() {
  return servicesStaticPathsData.map((item) => ({
    params: { service: item.slug },
    props: { content: item },
  }))
}

const { service } = Astro.params
const { content } = Astro.props

const faqKey = (service in serviceFaqsData ? service : 'landing-page') as keyof typeof serviceFaqsData
const titleKey = (service in serviceFaqTitlesData ? service : 'landing-page') as keyof typeof serviceFaqTitlesData

const currentFaqs = serviceFaqsData[faqKey] as FaqItem[]
const currentTitles = serviceFaqTitlesData[titleKey] ?? {
  eyebrow: 'Preguntas Frecuentes',
  title: 'Respuestas que necesitas',
  subtitle: 'Aclaramos las dudas más comunes sobre este servicio.',
}
---

<Layout>
  <Hero service={service}/>
  <CardsIntro service={service}/>
  <Intro service={service}/>
  <Description service={service}/>
  <Features service={service}/>
  <Process service={service}/>
  <Faqs1
    faqs={currentFaqs}
    eyebrow={currentTitles.eyebrow}
    title={currentTitles.title}
    subtitle={currentTitles.subtitle}
  />
  <CTAServices service={service}/>
  <More service={service}/>
</Layout>